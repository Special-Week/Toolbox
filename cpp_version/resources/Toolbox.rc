// 程序版本与清单，Unicode 资源由 windres 编译进可执行文件。
#pragma code_page(65001)
#include <windows.h>
#include "../include/toolbox/resource_ids.h"
// 资源文件路径相对于 cpp_version；许可文本随源码保存，无需构建时生成。
TOOLBOX_ICON ICON "resources/toolbox.ico"
TOOLBOX_LICENSE_TEXT RCDATA "licenses/third-party-licenses.txt"
TOOLBOX_GAUGE_TABLES RCDATA "resources/gauges/tables.json"
TOOLBOX_GAUGE_UNIFIED RCDATA "resources/gauges/unified.json"
TOOLBOX_STANDARD_CATALOG RCDATA "resources/standards.json"
TOOLBOX_CALIBRATION_DIALOG DIALOGEX 0, 0, 250, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "保存系数档案"
FONT 9, "Microsoft YaHei UI"
BEGIN
 LTEXT "档案名称", -1, 12, 12, 220, 12
 EDITTEXT TOOLBOX_CALIBRATION_NAME, 12, 28, 226, 15, ES_AUTOHSCROLL
 DEFPUSHBUTTON "保存", IDOK, 132, 61, 50, 18
 PUSHBUTTON "取消", IDCANCEL, 188, 61, 50, 18
END
1 RT_MANIFEST "resources/Toolbox.manifest"
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404b0"
  BEGIN
   VALUE "FileDescription", "工具箱\0"
   VALUE "ProductName", "Toolbox\0"
   VALUE "FileVersion", "0.1.0\0"
   VALUE "ProductVersion", "0.1.0\0"
   VALUE "OriginalFilename", "Toolbox.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x804, 1200
 END
END
