{
  "name": "toolbox-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:offline": "node --test scripts/service-worker.test.mjs scripts/build-cache.test.mjs",
    "test:pdf": "node --test scripts/pdf-download.test.mjs server/pdf-cache.test.mjs server/http.test.mjs",
    "test:curve": "node --test scripts/curve-chart.test.mjs",
    "test:spec-menu": "node --test scripts/spec-options.test.mjs",
    "test:uncertainty": "node --test scripts/masonry.test.mjs scripts/uncertainty-ui.test.cjs",
    "start": "node server/index.mjs",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "build": "npm run build:wasm && vue-tsc --noEmit && node scripts/clean-dist.mjs && vite build && node scripts/package-server.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
